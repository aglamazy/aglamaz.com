FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-client-email
FIREBASE_PRIVATE_KEY=your-private-key
FIREBASE_API_KEY=your-api-key
FIREBASE_AUTH_DOMAIN=your-auth-domain
FIREBASE_APP_ID=your-app-id
FIREBASE_MEASUREMENT_ID=your-measurement-id
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-site-verification

# agents-whatsapp scaffold (famcircle#34) — consumer-mode creds for the future
# direct WhatsApp integration. Distinct from WABA_BROADCAST_URL/WABA_ACCESS_TOKEN
# (not listed in this example file, but set in prod), which belong to the
# separate, already-working yahrzeit-broadcast system
# (src/services/WhatsAppService.ts) and are unrelated to this package.
WHATSAPP_TOKEN=your-whatsapp-cloud-api-token
WA_PHONE_NUMBER_ID=your-meta-phone-number-id
WABA_ID=your-delegated-waba-id
WA_APP_SECRET=your-meta-app-secret
WA_VERIFY_TOKEN=your-webhook-verify-token

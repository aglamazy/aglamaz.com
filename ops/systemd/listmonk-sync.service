[Unit]
Description=Sync FamCircle blog subscribers into Listmonk list 8 (scout#169, push-model)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=fcsync
Group=fcsync
# Secrets (LISTMONK_API_URL/LISTMONK_API_USER/LISTMONK_API_TOKEN,
# BLOG_SUBSCRIBERS_SYNC_SECRET) - Buddy-delivered, root:fcsync 640, never committed.
# Non-secret sync config lives here instead.
EnvironmentFile=/etc/famcircle-listmonk-sync.env
Environment=LISTMONK_SYNC_SITE_ID=XFptrxZIKXV6P2TjtGCL
Environment=LISTMONK_SYNC_LIST_ID=8
# FamCircle's own prod deploy - the sync fetches subscriber emails from here (bearer-secret
# guarded, see src/app/api/site/[siteId]/blog-subscribers/sync/route.ts), NOT from a Firebase
# Admin key on this host (Buddy's 2026-08-03 ruling: least privilege, ub04 gets exactly this
# one narrow read and nothing else).
Environment=BLOG_SUBSCRIBERS_SYNC_URL=https://aglamaz.com
Environment=FAMCIRCLE_CHECKOUT_DIR=/opt/famcircle-sync
ExecStart=/bin/sh -c '"$FAMCIRCLE_CHECKOUT_DIR"/scripts/listmonk-sync-cron.sh'
StandardOutput=journal
StandardError=journal
